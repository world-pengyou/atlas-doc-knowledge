# Public repository: deny by default, then allow reviewed source files only.
/*
!/.gitignore
!/.env.example
!/README.md
!/requirements.txt
!/requirements.lock
!/kb/
!/static/
!/tests/
!/scripts/
!/docs/

/kb/*
!/kb/*.py
/static/*
!/static/*.html
/tests/*
!/tests/test_*.py
/scripts/*
!/scripts/*.py
/docs/*
!/docs/dependencies.json
!/docs/existing-dependency-advisories.json

# Explicit local-only protection, including nested files and backups.
.env
.env.*
!/.env.example
*.pem
*.key
*.p12
*.pfx
*.log
*.bak
*.tmp
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
node_modules/
.codex/
.agents/
AGENTS.md
/data/
/models/
/tests/tmp*/
