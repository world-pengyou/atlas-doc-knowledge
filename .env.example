# Loopback by default; optional LAN access. Keep credentials in ignored .env.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/knowledge
# Independent presales database; leave blank to disable /presales/.
PRESALES_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/knowledge_presales
DATA_DIR=./data
PUBLIC_BASE_URL=http://127.0.0.1:8100
# Default is loopback only. For LAN, configure exact hosts and your LAN CIDR.
WEB_HOST=127.0.0.1
WEB_ALLOWED_HOSTS=127.0.0.1,localhost,::1
WEB_ALLOWED_NETWORKS=127.0.0.0/8,::1/128
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=
EMBEDDING_BACKEND=local
EMBEDDING_MODEL_PATH=./models/bge-m3
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSION=1024

# Cosine similarity threshold after hybrid fusion, from -1 to 1.
# Restart the service after changing search settings.
SEARCH_SIMILARITY_THRESHOLD=0.40
# Default returned chunk count, from 1 to 20. Explicit API limit overrides it.
SEARCH_TOP_K=5
